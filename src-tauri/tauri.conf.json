{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocabulario árabe",
  "version": "1.1.1",
  "identifier": "com.isa.vocabularioarabe",
  "build": {
    "beforeBuildCommand": "python3 build_vocab.py",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vocabulario árabe · Mi estudio",
        "width": 1200,
        "height": 850,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Education",
    "shortDescription": "Árabe con ejemplos, listas y repasos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
